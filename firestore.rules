rules_version = '2';

// SportsXtreme Firestore Security Rules
//
// SportsXtreme is a live cricket scoring platform. Scores are public
// (like Cricbuzz): any authenticated user can view live matches, scorecards
// and the live score injected in matches/{matchId}.liveScore.
//
// Writes require authentication. In this phase there is no per-user
// ownership restriction so that spectators (friends) can see live scores.
//
// DEPLOY: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isModerationAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function unchangedClaims() {
      return request.resource.data.get('teamAClaim', null) == resource.data.get('teamAClaim', null)
        && request.resource.data.get('teamBClaim', null) == resource.data.get('teamBClaim', null);
    }
    function validClaim(claim) {
      return claim.keys().hasOnly(['userId', 'displayName', 'replacedDummyPlayerId', 'claimedAt'])
        && claim.userId == request.auth.uid
        && claim.displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && claim.replacedDummyPlayerId is string
        && claim.claimedAt == request.time;
    }

    // ---------- Matches: authenticated read, owner write ----------
    // The Home screen listens to the whole collection with a SnapshotListener.
    // That requires collection-level read access for every authenticated user,
    // otherwise the friend's phone gets a permission-denied error and the
    // live scorecard never appears.
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('status', '') != 'COMPLETED'
        && request.resource.data.get('status', '') != 'FINALIZATION_PENDING'
        && request.resource.data.get('status', '') != 'FINALIZING'
        && request.resource.data.get('status', '') != 'FINALIZED'
        && !request.resource.data.keys().hasAny(['finalization', 'finalizedAt', 'finalizedBy', 'finalizationRevision', 'correctionState']);
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && (resource.data.get('status', '') != 'COMPLETED'
          || (request.resource.data.get('status', '') == 'FINALIZATION_PENDING'
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])))
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZING'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZED'
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['finalization', 'finalizedAt', 'finalizedBy', 'finalizationRevision', 'correctionState'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (request.resource.data.status != 'COMPLETED'
            && request.resource.data.status != 'FINALIZING'
            && request.resource.data.status != 'FINALIZED'
            && resource.data.get('finalization', {}).get('state', '') != 'FINALIZED'))
        && unchangedClaims()
        || isSignedIn() && resource.data.get('teamAClaim', null) == null
        && resource.data.get('status', '') != 'COMPLETED'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZING'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamAClaim', 'updatedAtEpochMs'])
        && validClaim(request.resource.data.teamAClaim)
        && resource.data.get('teamBClaim', {}).get('userId', '') != request.auth.uid
        && getAfter(/databases/$(database)/documents/matchInvites/$(matchId + '-team_a')).data.status == 'CLAIMED'
        && getAfter(/databases/$(database)/documents/matchInvites/$(matchId + '-team_a')).data.claimedByUserId == request.auth.uid
        || isSignedIn() && resource.data.get('teamBClaim', null) == null
        && resource.data.get('status', '') != 'COMPLETED'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZING'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamBClaim', 'updatedAtEpochMs'])
        && validClaim(request.resource.data.teamBClaim)
        && resource.data.get('teamAClaim', {}).get('userId', '') != request.auth.uid
        && getAfter(/databases/$(database)/documents/matchInvites/$(matchId + '-team_b')).data.status == 'CLAIMED'
        && getAfter(/databases/$(database)/documents/matchInvites/$(matchId + '-team_b')).data.claimedByUserId == request.auth.uid
        || isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scorecardViews'])
        && request.resource.data.get('scorecardViews', 0) is int
        && request.resource.data.get('scorecardViews', 0) == resource.data.get('scorecardViews', 0) + 1;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid
        && resource.data.get('status', '') != 'COMPLETED'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZING'
        && resource.data.get('finalization', {}).get('state', '') != 'FINALIZED';
    }

    // Subcollections under a match (deliveries, scorecard, entries, …)
    match /matches/{matchId}/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/matches/$(matchId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/matches/$(matchId)).data.get('status', '') != 'COMPLETED'
        && get(/databases/$(database)/documents/matches/$(matchId)).data.get('finalization', {}).get('state', '') != 'FINALIZING'
        && get(/databases/$(database)/documents/matches/$(matchId)).data.get('finalization', {}).get('state', '') != 'FINALIZED';
    }

    // Official statistics and leaderboard aggregates are public read models.
    // Cloud Functions use the Admin SDK for writes; clients cannot modify them.
    match /officialStats/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Match invites: organiser-owned, creation-only in Phase 3A ----------
    match /matchInvites/{inviteId} {
      // Temporary Spark-plan lookup permission. Replace with callable Function lookup in production.
      allow get, list: if isSignedIn();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'inviteId', 'matchId', 'teamSlot', 'organiserId', 'tokenHash', 'status',
          'createdAt', 'expiresAt', 'claimedByUserId', 'claimedAt'
        ])
        && request.resource.data.inviteId == inviteId
        && request.resource.data.organiserId == request.auth.uid
        && request.resource.data.teamSlot in ['TEAM_A', 'TEAM_B']
        && request.resource.data.status == 'OPEN'
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && request.resource.data.claimedByUserId == null
        && request.resource.data.claimedAt == null
        && request.resource.data.createdAt <= request.time
        && request.resource.data.expiresAt > request.time
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.status == 'OPEN'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByUserId', 'claimedAt'])
        && request.resource.data.status == 'CLAIMED'
        && request.resource.data.claimedByUserId == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && ((resource.data.teamSlot == 'TEAM_A'
          && getAfter(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.teamAClaim.userId == request.auth.uid)
          || (resource.data.teamSlot == 'TEAM_B'
          && getAfter(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.teamBClaim.userId == request.auth.uid));
      allow delete: if false;
    }

    // ---------- Tournaments: organisers manage tournament details; team entries are callable-only ----------
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;
    }
    match /tournaments/{tournamentId}/pointsTable/{tableId} {
      allow read: if request.auth != null;
      allow write: if isSignedIn()
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid;
    }
    match /tournaments/{tournamentId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- Teams: membership and role changes are callable-only ----------
    match /teams/{teamId} {
      allow read: if request.auth != null;
      // The initial creator must be the sole, dual-role member. Every later
      // membership change runs in a Cloud Function transaction, preventing a
      // client from granting itself ADMIN/CAPTAIN or bypassing the 18-player cap.
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].userId == request.auth.uid
        && request.resource.data.members[0].roles.size() == 2
        && request.resource.data.members[0].roles.hasAll(['ADMIN', 'CAPTAIN'])
        && request.resource.data.members[0].playingRole == 'PLAYER';
      allow update, delete: if false;
    }
    match /teams/{teamId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- Team invites: only Cloud Functions may create or inspect them ----------
    // Raw tokens never reach Firestore; their SHA-256 hash is the document ID.
    match /teamInvites/{inviteId} {
      allow read, write: if false;
    }

    // ---------- Community profiles: visible to signed-in community members ----------
    match /communityProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        (request.resource.data.postType == 'request'
          && request.resource.data.keys().hasOnly([
            'postType', 'ownerId', 'name', 'title', 'category', 'description',
            'date', 'time', 'location', 'format', 'profilePhotoUrl', 'whatsappConsent', 'createdAt'
          ])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.category in ['Batter', 'Bowler', 'All Rounder', 'Wicket Keeper', 'Umpire']
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 500
          && request.resource.data.date is string
          && request.resource.data.time is string
          && request.resource.data.location is string
          && request.resource.data.format is string
          && request.resource.data.profilePhotoUrl is string
          && request.resource.data.whatsappConsent == true
          && request.resource.data.createdAt == request.time)
        || (request.resource.data.keys().hasOnly([
          'ownerId', 'name', 'category', 'location', 'organization',
          'experience', 'groundType', 'ballType', 'chargePerMatch', 'profilePhotoUrl', 'whatsappConsent', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.location is string
        && request.resource.data.organization is string
        && request.resource.data.experience is string
        && request.resource.data.groundType is string
        && request.resource.data.ballType is string
        && request.resource.data.chargePerMatch is string
        && request.resource.data.profilePhotoUrl is string
        && request.resource.data.whatsappConsent == true
        && request.resource.data.createdAt == request.time));
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isModerationAdmin();

      match /private/{privateDocument} {
        allow get: if isSignedIn()
          && privateDocument == 'contact'
          && get(/databases/$(database)/documents/communityProfiles/$(profileId)).data.whatsappConsent == true;
        allow list: if false;
        allow create, update: if isSignedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'whatsappNumber'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.whatsappNumber is string
          && request.resource.data.whatsappNumber.size() >= 10
          && request.resource.data.whatsappNumber.size() <= 15
          && getAfter(/databases/$(database)/documents/communityProfiles/$(profileId)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/communityProfiles/$(profileId)).data.whatsappConsent == true;
        allow delete: if isSignedIn()
          && resource.data.ownerId == request.auth.uid;
      }
    }

    // ---------- Registered grounds: available when setting up a friendly match ----------
    match /grounds/{groundId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'location', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 240
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isModerationAdmin();
    }

    // Reporters may check their own report for duplicate protection. Moderators
    // can review the queue and record the outcome; reports cannot be deleted.
    match /communityPostReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['postId', 'postOwnerId', 'reporterId', 'reason', 'description', 'status', 'createdAt'])
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/communityProfiles/$(request.resource.data.postId))
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postOwnerId == get(/databases/$(database)/documents/communityProfiles/$(request.resource.data.postId)).data.ownerId
        && request.resource.data.postOwnerId != request.auth.uid
        && request.resource.data.reason in [
          'Spam or misleading listing', 'Fake identity or impersonation',
          'Inappropriate or offensive content', 'Phone number or contact misuse',
          'Fraud or scam', 'Not sports-related', 'Duplicate listing', 'Other'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/communityPostReports/$(reportId));
      allow get: if isModerationAdmin()
        || (isSignedIn() && (!exists(/databases/$(database)/documents/communityPostReports/$(reportId))
          || resource.data.reporterId == request.auth.uid));
      allow list: if isModerationAdmin();
      allow update: if isModerationAdmin()
        && request.resource.data.keys().hasOnly([
          'postId', 'postOwnerId', 'reporterId', 'reason', 'description',
          'status', 'createdAt', 'reviewedAt', 'reviewedBy', 'actionTaken'
        ])
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.postOwnerId == resource.data.postOwnerId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['OPEN', 'UNDER_REVIEW', 'RESOLVED', 'DISMISSED']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.actionTaken is string
        && request.resource.data.actionTaken.size() <= 500;
      allow delete: if false;
    }

    // ---------- User profiles: readable by signed-in players ----------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      // Stats are shown on player profiles; settings and achievements remain owner-only.
      allow read: if request.auth != null
        && (request.auth.uid == userId || document == 'stats/summary');
      allow write: if request.auth != null && request.auth.uid == userId && document != 'stats/summary';
    }
  }
}
